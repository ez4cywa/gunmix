<Window x:Class="GunMix.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WinBg}">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelText" Text="名称：" FontWeight="Bold"/>
        <TextBox x:Name="ValueBox" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="80" Margin="0,0,8,0" Click="OnOk" IsDefault="True"/>
            <Button Content="取消" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
