<Window x:Class="GunMix.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在扫描素材" Width="460" SizeToContent="Height" WindowStyle="ToolWindow"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource WinBg}">
    <StackPanel Margin="16">
        <TextBlock x:Name="TitleText" Text="正在扫描…" FontWeight="Bold"/>
        <TextBlock x:Name="ProgressText" Text="已检查 0 / 0" Margin="0,8,0,4" Foreground="{StaticResource TextSecondary}"/>
        <ProgressBar x:Name="Bar" Height="10" Minimum="0" Maximum="100"/>
        <Button Content="取消" Width="90" Margin="0,12,0,0" HorizontalAlignment="Right" Click="OnCancel"/>
    </StackPanel>
</Window>
