<Window x:Class="GunMix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:GunMix.App.Controls"
        Title="枪声分层工作台" Width="1440" Height="900" MinWidth="1280" MinHeight="720"
        Background="{StaticResource WinBg}" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">

    <Window.Resources>
        <ctl:StringToBrushConverter x:Key="StringToBrush"/>
        <ctl:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Grid Margin="8,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <!-- ═══ 顶部 ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="枪声分层工作台" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProjectInfo}" FontSize="13" Margin="24,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="导入文件夹" Command="{Binding ImportCommand}" MinWidth="96"/>
                <Button Content="打开工程" Command="{Binding OpenCommand}" MinWidth="84" Margin="8,0,0,0"/>
                <Button Content="保存" Command="{Binding SaveCommand}" MinWidth="70" Margin="8,0,0,0"/>
                <Button Content="动画音效…" MinWidth="92" Margin="8,0,0,0" Click="OnOpenAnimation"
                        ToolTip="读取 .cast 的音频通知，把装弹、检视、举枪等动画装配成完整音效并导出"/>
                <Button Content="导出单发 / 连发" Command="{Binding ExportCommand}" MinWidth="120" Margin="8,0,0,0"
                        Style="{StaticResource AccentButton}"/>
            </StackPanel>
        </Grid>

        <!-- ═══ 主区 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- 空工程状态：唯一主入口，不展示假波形或假电平 -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding ProjectLoaded, Converter={StaticResource InverseBoolToVis}}">
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="从导入音频文件夹开始" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="选择单把武器的 WAV 目录，或包含多把武器的上层目录。软件按文件名自动分组，之后逐层试听调整，再分别导出单发与连发。"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,10,0,20" LineHeight="21"/>
                        <Button Content="导入音频文件夹" Command="{Binding ImportCommand}" Style="{StaticResource AccentButton}"
                                MinWidth="220" MinHeight="36" FontSize="14" HorizontalAlignment="Center"/>
                        <Button Content="打开已有工程 (.gunmix.json)" Command="{Binding OpenCommand}" MinWidth="220" MinHeight="32"
                                Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="支持单/双声道 PCM 16 / 24 / 32 bit 与 IEEE float 32 bit WAV；其他采样率在使用时转换为工程 48 kHz，原文件保持不变。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 左：武器与素材库 ── -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="武器 / 素材库" Style="{StaticResource SectionHeader}"/>
                        <Button Grid.Column="1" Content="＋武器" FontSize="11" MinHeight="22" Padding="6,1"
                                Command="{Binding AddWeaponCommand}" ToolTip="添加一把武器（每把武器独立素材、配方与导出）"/>
                    </Grid>
                    <TextBox Grid.Row="1" Text="{Binding AssetSearch, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索当前武器的分组或文件名"/>
                    <StackPanel Grid.Row="2" Margin="0,8,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedWeapon}"
                                      DisplayMemberPath="Display" ToolTip="切换武器（不沿用上一把枪的样本池、射速或导出名称）"/>
                            <Button Grid.Column="1" Content="✎" FontSize="11" MinHeight="26" MinWidth="26" Margin="6,0,0,0"
                                    Command="{Binding RenameWeaponCommand}" ToolTip="重命名当前武器"/>
                        </Grid>
                        <!-- 枪型合成模板：键值对照，设计依据折叠；数值为试混建议 -->
                        <Border Background="{StaticResource PanelBgLight}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="枪型" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding WeaponTypeOptions}" SelectedItem="{Binding CurrentWeaponType}"
                                              ToolTip="由素材目录前缀（ar_/sm_/lm_/dm_/pi_/sn_）判定，可修改；决定自适应配方的合成模板"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="射击方式" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentProfile.FireModeLabel}" Style="{StaticResource FieldValue}"/>
                                    <TextBlock Grid.Row="1" Text="默认连发" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentProfile.BurstLabel}" Style="{StaticResource FieldValue}"
                                               FontFamily="Consolas, Microsoft YaHei UI"/>
                                    <TextBlock Grid.Row="2" Text="主体目标" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentProfile.ShotTargetLabel}" Style="{StaticResource FieldValue}"
                                               FontFamily="Consolas, Microsoft YaHei UI" ToolTip="主体层前 250 ms RMS 的目标电平；各层增益由此与素材实测响度反推"/>
                                    <TextBlock Grid.Row="3" Text="层相对主体" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentProfile.LayerTargetsLabel}" Style="{StaticResource FieldValue}"
                                               FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Text="连发实例" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentProfile.VoiceLimitLabel}" Style="{StaticResource FieldValue}"/>
                                </Grid>
                                <Expander Header="模板依据" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11">
                                    <TextBlock Text="{Binding CurrentProfile.Notes}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                               Margin="0,2,0,0" LineHeight="17"/>
                                </Expander>
                                <UniformGrid Columns="2" Margin="0,6,0,0">
                                    <Button Content="按枪型生成配方" Command="{Binding RegenerateAdaptiveCommand}" FontSize="12" Margin="0,0,3,0"
                                            ToolTip="按枪型模板和素材实测响度，为普通 / ADS / 消音 / NPC 距离生成“自适应·”配方；只替换旧的自适应配方"/>
                                    <Button Content="响度配平" Command="{Binding RebalanceCommand}" FontSize="12" Margin="3,0,0,0"
                                            ToolTip="按枪型的层间响度目标重算当前配方各层增益（保留开关、延时和素材池），并做峰值保护"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TreeView Grid.Row="3" ItemsSource="{Binding AssetTree}" VirtualizingPanel.IsVirtualizing="False"
                              AllowDrop="False" ToolTip="双击文件试听（直接文件预听与配方播放互斥）；右键把分组指定到选中层">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="11" Margin="8,0,0,0"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="Tag" Value="{Binding}"/>
                                <EventSetter Event="MouseDoubleClick" Handler="OnAssetDoubleClick"/>
                                <EventSetter Event="ContextMenuOpening" Handler="OnAssetContextMenu"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <StackPanel Grid.Row="4" Margin="0,6,0,0">
                        <TextBlock Text="分组来源：文件名（手动分组优先）" Style="{StaticResource HintText}"/>
                        <TextBlock Text="last / interrupt / fcg 为实验分支，默认不启用；原版事件条件未确认" Style="{StaticResource WarnText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- ── 中：混音区 + 序列 ── -->
            <Grid Grid.Column="1" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 配方行 -->
                <Grid Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="当前配方" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                              DisplayMemberPath="Display" MaxWidth="360" HorizontalAlignment="Left" MinWidth="220"/>
                    <Button Grid.Column="2" Content="重命名" Margin="8,0,0,0" Command="{Binding RenameRecipeCommand}"/>
                    <Button Grid.Column="3" Content="复制为新配方" Margin="8,0,0,0" Command="{Binding CopyRecipeCommand}"
                            ToolTip="ADS、消音与 NPC 版本建议通过复制建立；缺素材时显示“待指定”，不偷偷借用普通版"/>
                    <TextBlock Grid.Column="4" Text="教学预设 · 可编辑" Foreground="{StaticResource WarnYellow}" FontSize="12"
                               VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTeachingPreset}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Expander Grid.Row="1" Grid.ColumnSpan="5" Header="配方说明（配平依据、缺失与复用素材）" Margin="0,4,0,0"
                              Foreground="{StaticResource TextSecondary}"
                              Visibility="{Binding HasRecipeNotes, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding RecipeNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" Background="#1B2128" FontSize="12"/>
                    </Expander>
                </Grid>

                <!-- 表头 -->
                <Border Grid.Row="1" Background="{StaticResource PanelBgLight}" CornerRadius="3" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" SharedSizeGroup="c0"/>
                            <ColumnDefinition Width="160" SharedSizeGroup="c1"/>
                            <ColumnDefinition Width="28" SharedSizeGroup="c2"/>
                            <ColumnDefinition Width="1.2*" SharedSizeGroup="c3"/>
                            <ColumnDefinition Width="1.3*" SharedSizeGroup="c4"/>
                            <ColumnDefinition Width="1.1*" SharedSizeGroup="c5"/>
                            <ColumnDefinition Width="1.6*" SharedSizeGroup="c6"/>
                            <ColumnDefinition Width="30" SharedSizeGroup="c7"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="层/开关" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="名称" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="S" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" ToolTip="独听（仅影响监听）"/>
                        <TextBlock Grid.Column="3" Text="素材池 / 当前变体" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="4" Text="增益 dB (-60 ～ +6)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="5" Text="延时 ms (0 ～ 1000)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock Grid.Column="6" Text="波形示意" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                </Border>

                <!-- 层列表 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="3" Margin="0,0,0,4" Padding="6,4" Cursor="Hand"
                                        MouseLeftButtonDown="OnLayerRowMouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource RowBg}"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource RowBgHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="1.2*" MinWidth="120"/>
                                            <ColumnDefinition Width="1.3*" MinWidth="150"/>
                                            <ColumnDefinition Width="1.1*" MinWidth="130"/>
                                            <ColumnDefinition Width="1.6*" MinWidth="110"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="开关（关闭本层）"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                                <Border Style="{StaticResource WarnTag}"
                                                        Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="实验层：触发条件为用户设定，原版条件未确认">
                                                    <TextBlock Text="实验" FontSize="10" Foreground="{StaticResource WarnYellow}"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2" Content="S" FontSize="11" Padding="2,1" MinWidth="22" MinHeight="22"
                                                      Style="{StaticResource ToggleButton}"
                                                      IsChecked="{Binding Solo}" VerticalAlignment="Center"
                                                      ToolTip="独听：只试听选中的独听层，多个 Solo 可共存；独听不改变导出层"/>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PoolDisplay}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentVariant}" FontSize="11" Foreground="{StaticResource AccentText}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentVariant}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="-60" Maximum="6" Value="{Binding GainDb}"
                                                    SmallChange="0.5" LargeChange="3" VerticalAlignment="Center"
                                                    ToolTip="拖动或右侧输入（-60 ～ +6 dB）"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource NumericBox}"
                                                     Text="{Binding GainDb, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"/>
                                        </Grid>
                                        <Grid Grid.Column="5" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="1000" Value="{Binding DelayMs}"
                                                    SmallChange="0.1" LargeChange="10" VerticalAlignment="Center"
                                                    ToolTip="拖动或右侧输入（0 ～ 1000 ms，支持 0.1 ms）"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource NumericBox}"
                                                     Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"/>
                                        </Grid>
                                        <Border Grid.Column="6" Background="{StaticResource InputBg}" CornerRadius="2" ClipToBounds="True" MinWidth="100">
                                            <ctl:WaveformView Peaks="{Binding Peaks}" Height="40" VerticalAlignment="Stretch"/>
                                        </Border>
                                        <Button Grid.Column="7" Content="▶" FontSize="10" MinWidth="22" MinHeight="22" VerticalAlignment="Center"
                                                Click="OnPlayLayerClick" ToolTip="单层试听"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="row" Property="Background" Value="{StaticResource RowBgSelected}"/>
                                        <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                    <!-- 关闭的层整行减淡：不参与导出，一眼可辨 -->
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 序列 -->
                <Border Grid.Row="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="序列" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ToggleButton Grid.Column="1" Content="单发" IsChecked="{Binding SingleMode}" Style="{StaticResource ToggleButton}"/>
                            <ToggleButton Grid.Column="2" Content="连发" IsChecked="{Binding BurstMode}" Style="{StaticResource ToggleButton}" Margin="6,0,0,0"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="24,0,0,0">
                                <TextBlock Text="射速 RPM" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding BurstRpm, UpdateSourceTrigger=LostFocus}" Width="64" IsEnabled="{Binding BurstMode}"
                                         Style="{StaticResource NumericBox}" ToolTip="6 – 1800 RPM"/>
                                <TextBlock Text="发数" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <TextBox Text="{Binding BurstShotCount, UpdateSourceTrigger=LostFocus}" Width="54" IsEnabled="{Binding BurstMode}"
                                         Style="{StaticResource NumericBox}" ToolTip="1 – 100 发"/>
                                <CheckBox Content="松扳机尾音" IsChecked="{Binding ReleaseTailEnabled}" VerticalAlignment="Center"
                                          Margin="12,0,0,0" IsEnabled="{Binding ReleaseTailAvailable}"
                                          ToolTip="连发末发起点 + 一个射击间隔处触发一次 *_plr_interrupt（松开扳机的尾声）；只进入连发导出，单发不受影响。原版触发条件未确认。"/>
                                <TextBlock Text="固定种子" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <TextBox Text="{Binding RandomSeed, UpdateSourceTrigger=LostFocus}" Width="80" Style="{StaticResource NumericBox}"
                                         ToolTip="随机变体的种子；同种子同算法版本可重现"/>
                                <Button Content="重新生成变体" Margin="12,0,0,0" Command="{Binding RegenerateCommand}"
                                        ToolTip="点击后才产生新的事件清单；播放、停止再播、导出都复用当前清单"/>
                            </StackPanel>
                            <TextBlock Grid.Column="6" Text="{Binding ManifestStatus}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{Binding ManifestStatusColor, Converter={StaticResource StringToBrush}}"/>
                        </Grid>
                        <ctl:TimelineCanvas Markers="{Binding TimelineMarkers}" TotalSeconds="{Binding TotalSeconds}"
                                            PlayheadSeconds="{Binding PlayheadSeconds}" Height="88" Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="A/B：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <Button Content="存为 A" Command="{Binding SetSnapshotACommand}"/>
                                <Button Content="存为 B" Command="{Binding SetSnapshotBCommand}" Margin="6,0,0,0"/>
                                <Button Content="应用 A" Command="{Binding ApplySnapshotACommand}" Margin="6,0,0,0"
                                        ToolTip="{Binding SnapshotALabel}"/>
                                <Button Content="应用 B" Command="{Binding ApplySnapshotBCommand}" Margin="6,0,0,0"
                                        ToolTip="{Binding SnapshotBLabel}"/>
                                <TextBlock Text="监听补偿 dB" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox Text="{Binding MonitorCompensationDb, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" Width="56"
                                         Style="{StaticResource NumericBox}"
                                         ToolTip="仅影响监听，显示数值；不进入导出"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="事件表可替换指定发样本（右键）" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Expander Header="事件表（展开可查看与替换每发样本）" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}">
                            <DataGrid ItemsSource="{Binding EventRows}" MaxHeight="170" FontSize="12"
                                      MouseRightButtonUp="OnEventRowRightClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="层" Binding="{Binding LayerName}" Width="90"/>
                                    <DataGridTextColumn Header="发" Binding="{Binding ShotDisplay}" Width="70"/>
                                    <DataGridTextColumn Header="起点 s" Binding="{Binding TimeS}" Width="80"/>
                                    <DataGridTextColumn Header="文件" Binding="{Binding File}" Width="*"/>
                                    <DataGridTextColumn Header="增益 dB" Binding="{Binding GainDb, StringFormat={}{0:0.0}}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 右：属性区 ── -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Style="{StaticResource SectionHeader}">
                            <Run Text="层属性　"/>
                            <Run Text="{Binding SelectedLayer.Name, Mode=OneWay}" Foreground="{StaticResource AccentText}"/>
                        </TextBlock>

                        <TextBlock Text="素材格式" Style="{StaticResource HintText}"/>
                        <TextBlock Text="{Binding SelectedLayer.FormatDisplay}" Margin="0,0,0,8"/>

                        <TextBlock Text="文件长度" Style="{StaticResource HintText}"/>
                        <TextBlock Text="{Binding SelectedLayer.LengthDisplay}" Margin="0,0,0,8"/>

                        <TextBlock Text="完整路径（可复制）" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding SelectedLayer.PathDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="60" VerticalScrollBarVisibility="Auto" Background="#1B2128" Margin="0,2,0,8"/>

                        <TextBlock Text="样本选择" Style="{StaticResource HintText}"/>
                        <ComboBox SelectedValue="{Binding SelectedLayer.VariantMode}" SelectedValuePath="Value"
                                  DisplayMemberPath="Label" ItemsSource="{Binding VariantModeOptions}" Margin="0,2,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="层种子" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource HintText}"/>
                            <TextBox Text="{Binding SelectedLayer.Seed, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Width="80"
                                     Style="{StaticResource NumericBox}" VerticalContentAlignment="Center"
                                     ToolTip="随机模式使用；留空则用配方种子"/>
                            <TextBlock Text="固定样本" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource HintText}"/>
                            <ComboBox Width="110" ItemsSource="{Binding SelectedLayer.Pool}"
                                      SelectedValuePath="Id" DisplayMemberPath="VariantLabel"
                                      SelectedValue="{Binding SelectedLayer.FixedAssetId}"/>
                        </StackPanel>

                        <TextBlock Text="素材池（选定分组指定到该层）" Style="{StaticResource HintText}"/>
                        <ComboBox x:Name="CmbPoolAssign" ItemsSource="{Binding AvailableGroupKeys}" Margin="0,2,0,8"
                                  ToolTip="把当前武器的某个分组作为该层素材池"/>
                        <Button Content="把选定分组指定到该层" Click="OnAssignPoolClick"/>

                        <TextBlock Text="素材响度（配平依据）" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedLayer.LoudnessDisplay}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="连发同时发声上限" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource HintText}"/>
                            <TextBox Text="{Binding SelectedLayer.BurstVoiceLimit, UpdateSourceTrigger=LostFocus}" Width="44"
                                     Style="{StaticResource NumericBox}"
                                     ToolTip="0 = 不限；超出时最旧实例在新一发起点 30 ms 淡出（只影响连发，单发不受影响）"/>
                        </StackPanel>
                        <TextBlock Text="全自动枪型的 ATMO 默认限 3–4 个实例，防止长连射空间层堆高；试混建议，非原版参数"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Separator/>

                        <TextBlock Text="实验触发规则" Style="{StaticResource HintText}"/>
                        <CheckBox IsChecked="{Binding SelectedLayer.IsExperimental}"
                                  Margin="0,2,0,4">
                            <TextBlock Text="作为实验层启用（last / interrupt / FCG）" TextWrapping="Wrap"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ComboBox Width="130" SelectedValue="{Binding SelectedLayer.Trigger}" SelectedValuePath="Value"
                                      DisplayMemberPath="Label" ItemsSource="{Binding TriggerOptions}"
                                      IsEnabled="{Binding SelectedLayer.IsExperimental}"/>
                            <TextBlock Text="第 N 发" Margin="8,0,6,0" VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                            <TextBox Text="{Binding SelectedLayer.TriggerShotNumber, UpdateSourceTrigger=LostFocus}" Width="44"
                                     IsEnabled="{Binding SelectedLayer.IsExperimental}"/>
                        </StackPanel>
                        <TextBlock Text="用户设定，原版条件未确认；释放时刻 = 最后一发起点 + 一个射击间隔" Style="{StaticResource WarnText}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="规则来源" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedLayer.RuleSource}" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="播放本层" Click="OnPlayLayerClick"/>
                            <Button Content="添加层" Command="{Binding AddLayerCommand}" Margin="6,0,0,0"/>
                            <Button Content="删除层" Command="{Binding RemoveLayerCommand}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <Separator/>

                        <TextBlock Text="分别输出（当前武器）" Style="{StaticResource SectionHeader}"/>
                        <CheckBox Content="单发音效" IsChecked="True" IsEnabled="False" ToolTip="在导出对话框中选择"/>
                        <CheckBox Content="连发音效" IsChecked="True" IsEnabled="False" Margin="0,4,0,6" ToolTip="在导出对话框中选择"/>
                        <TextBlock Text="两份 WAV + 各自 recipe JSON" Style="{StaticResource HintText}"/>
                        <TextBlock Text="48 kHz / 24 bit / 立体声（可选 16 bit、32 float）" Style="{StaticResource HintText}" Margin="0,2,0,8"/>
                        <Button Content="导出单发 / 连发…" Command="{Binding ExportCommand}" Style="{StaticResource AccentButton}"/>

                        <Separator/>
                        <TextBlock Text="工程" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="重命名工程" Command="{Binding RenameProjectCommand}"/>
                            <Button Content="另存为…" Command="{Binding SaveAsCommand}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="保存 .gunmix.json；引用原素材，素材丢失时可重定位；打包工程放入 assets 目录为后续版本功能。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══ 底部播放条 ═══ -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,6,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="播放预览" Command="{Binding PlayCommand}" MinWidth="90" Style="{StaticResource AccentButton}"/>
                <Button Grid.Column="1" Content="停止试听" Command="{Binding StopCommand}" MinWidth="84" Margin="8,0,0,0"
                        ToolTip="短淡出停止当前输出（播放器操作，不触发 interrupt / last / FCG）"/>
                <Button Grid.Column="2" Content="撤销" Command="{Binding UndoCommand}" MinWidth="52" Margin="12,0,0,0"/>
                <Button Grid.Column="3" Content="重做" Command="{Binding RedoCommand}" MinWidth="52" Margin="6,0,0,0"/>
                <TextBlock Grid.Column="4" Text="{Binding PlayTimeText}" FontFamily="Consolas" VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                <TextBlock Grid.Column="6" Text="{Binding ErrorText}" VerticalAlignment="Center" Margin="10,0,10,0"
                           Foreground="{StaticResource ErrorRed}" FontSize="12" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorText}"/>
                <TextBlock Grid.Column="7" Text="{Binding DeviceName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="L" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="LevelLBar" Width="70" Height="10" Maximum="1" Value="{Binding LevelL, Mode=OneWay}" Margin="4,0,8,0"/>
                    <TextBlock Text="R" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="LevelRBar" Width="70" Height="10" Maximum="1" Value="{Binding LevelR, Mode=OneWay}" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
