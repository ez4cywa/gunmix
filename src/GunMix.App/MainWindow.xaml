<Window x:Class="GunMix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:GunMix.App.Controls"
        Title="枪声分层工作台" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource WinBg}" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing" SizeChanged="OnWorkspaceSizeChanged">

    <Window.Resources>
        <ctl:StringToBrushConverter x:Key="StringToBrush"/>
        <ctl:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文件操作与制作入口分开，标题始终留有空间。 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="枪声分层工作台" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ProjectInfo}" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectInfo}" Margin="0,4,12,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="打开工程" Command="{Binding OpenCommand}" Margin="0,0,8,0" ToolTip="Ctrl+O"/>
                <Button Content="保存工程" Command="{Binding SaveCommand}" Margin="0,0,8,0" ToolTip="Ctrl+S"/>
                <Button Content="导出单发 / 连发" Command="{Binding ExportCommand}" Style="{StaticResource AccentButton}" ToolTip="Ctrl+E"/>
            </WrapPanel>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBg}" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Content="动画音效" Click="OnOpenAnimation" IsEnabled="{Binding ProjectLoaded}" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="InspectorToggle" Content="层设置" Style="{StaticResource ToggleButton}"
                                      IsEnabled="{Binding ProjectLoaded}" Checked="OnInspectorToggle" Unchecked="OnInspectorToggle"
                                      AutomationProperties.Name="显示或隐藏层设置" ToolTip="选中一层后编辑样本、增益和高级规则"/>
                    </WrapPanel>
                    <TextBlock Text="1  选择武器与素材     →     2  调整分层与序列     →     3  试听并导出"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ 主区 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 空工程状态：唯一主入口，不展示假波形或假电平 -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding ProjectLoaded, Converter={StaticResource InverseBoolToVis}}">
                <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="从导入音频文件夹开始" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="选择单把武器的 WAV 目录，或包含多把武器的上层目录。软件按文件名自动分组，之后逐层试听调整，再分别导出单发与连发。"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,10,0,20" LineHeight="21"/>
                        <Button Content="导入音频文件夹" Command="{Binding ImportCommand}" Style="{StaticResource AccentButton}"
                                MinWidth="220" MinHeight="36" FontSize="14" HorizontalAlignment="Center"/>
                        <Button Content="打开已有工程 (.gunmix.json)" Command="{Binding OpenCommand}" MinWidth="220" MinHeight="32"
                                Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="支持单/双声道 PCM 16 / 24 / 32 bit 与 IEEE float 32 bit WAV；其他采样率在使用时转换为工程 48 kHz，原文件保持不变。"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 左：武器与素材库 ── -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"
                    Visibility="{Binding ProjectLoaded, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1  武器与素材" Style="{StaticResource SectionHeader}"/>
                        <Button Grid.Column="1" Content="添加" FontSize="13" MinHeight="30" Padding="8,3"
                                Command="{Binding AddWeaponCommand}" ToolTip="添加一把武器（每把武器独立素材、配方与导出）"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="搜索素材 / 分组" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                        <TextBox AutomationProperties.Name="搜索素材分组或文件名" Text="{Binding AssetSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索当前武器的分组或文件名"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,8,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Weapons}" SelectedItem="{Binding SelectedWeapon}"
                                      AutomationProperties.Name="当前武器" DisplayMemberPath="Display" ToolTip="切换武器（不沿用上一把枪的样本池、射速或导出名称）"/>
                            <Button Grid.Column="1" Content="改名" FontSize="13" MinHeight="32" MinWidth="48" Margin="6,0,0,0"
                                    Command="{Binding RenameWeaponCommand}" ToolTip="重命名当前武器"/>
                        </Grid>
                        <!-- 枪型合成模板：键值对照，设计依据折叠；数值为试混建议 -->
                        <Expander Header="枪型模板与响度配平" Margin="0,10,0,0">
                        <Border Background="{StaticResource PanelBgLight}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="枪型" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding WeaponTypeOptions}" SelectedItem="{Binding CurrentWeaponType}"
                                              ToolTip="由素材目录前缀（ar_/sm_/lm_/dm_/pi_/sn_）判定，可修改；决定自适应配方的合成模板"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="射击方式" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentProfile.FireModeLabel}" Style="{StaticResource FieldValue}"/>
                                    <TextBlock Grid.Row="1" Text="默认连发" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentProfile.BurstLabel}" Style="{StaticResource FieldValue}"
                                               FontFamily="Consolas, Microsoft YaHei UI"/>
                                    <TextBlock Grid.Row="2" Text="主体目标" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentProfile.ShotTargetLabel}" Style="{StaticResource FieldValue}"
                                               FontFamily="Consolas, Microsoft YaHei UI" ToolTip="主体层前 250 ms RMS 的目标电平；各层增益由此与素材实测响度反推"/>
                                    <TextBlock Grid.Row="3" Text="层相对主体" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentProfile.LayerTargetsLabel}" Style="{StaticResource FieldValue}"
                                               FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"/>
                                    <TextBlock Grid.Row="4" Text="连发实例" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentProfile.VoiceLimitLabel}" Style="{StaticResource FieldValue}"/>
                                </Grid>
                                <Expander Header="模板依据" Margin="0,4,0,0" Foreground="{StaticResource TextSecondary}" FontSize="13">
                                    <TextBlock Text="{Binding CurrentProfile.Notes}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                                               Margin="0,2,0,0" LineHeight="17"/>
                                </Expander>
                                <StackPanel Margin="0,6,0,0">
                                    <Button Content="按枪型生成配方" Command="{Binding RegenerateAdaptiveCommand}" FontSize="13" Margin="0,0,3,0"
                                            ToolTip="按枪型模板和素材实测响度，为普通 / ADS / 消音 / NPC 距离生成“自适应·”配方；只替换旧的自适应配方"/>
                                    <Button Content="响度配平" Command="{Binding RebalanceCommand}" FontSize="13" Margin="0,6,0,0"
                                            ToolTip="按枪型的层间响度目标重算当前配方各层增益（保留开关、延时和素材池），并做峰值保护"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Expander>
                    </StackPanel>
                    <TreeView Grid.Row="3" ItemsSource="{Binding AssetTree}" VirtualizingPanel.IsVirtualizing="False"
                              AllowDrop="False" ToolTip="双击文件试听（直接文件预听与配方播放互斥）；右键把分组指定到选中层">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="13" Margin="8,0,0,0"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="Tag" Value="{Binding}"/>
                                <EventSetter Event="MouseDoubleClick" Handler="OnAssetDoubleClick"/>
                                <EventSetter Event="ContextMenuOpening" Handler="OnAssetContextMenu"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button Content="导入音频文件夹" Command="{Binding ImportCommand}" Margin="0,0,0,8"/>
                        <Expander Header="工程选项" Margin="0,0,0,8">
                            <StackPanel Margin="0,8,0,0">
                                <Button Content="另存为…" Command="{Binding SaveAsCommand}" Margin="0,0,0,6"/>
                                <Button Content="重命名工程" Command="{Binding RenameProjectCommand}"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="分组来源：文件名（手动分组优先）" Style="{StaticResource HintText}"/>
                        <TextBlock Text="last / interrupt / fcg 为实验分支，默认不启用；原版事件条件未确认" Style="{StaticResource WarnText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <!-- ── 中：混音区 + 序列 ── -->
            <ScrollViewer x:Name="MixerScroll" Grid.Column="1" Margin="0,0,8,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ProjectLoaded, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 配方行 -->
                <Grid Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="2  混音配方" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                              AutomationProperties.Name="当前混音配方" DisplayMemberPath="Display" HorizontalAlignment="Stretch" MinWidth="140"/>
                    <Button Grid.Column="2" Content="重命名" Margin="8,0,0,0" Command="{Binding RenameRecipeCommand}"/>
                    <Button Grid.Column="3" Content="复制配方" Margin="6,0,0,0" Command="{Binding CopyRecipeCommand}"
                            ToolTip="ADS、消音与 NPC 版本建议通过复制建立；缺素材时显示“待指定”，不偷偷借用普通版"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="教学预设 · 可编辑" Foreground="{StaticResource WarnYellow}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTeachingPreset}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Expander Grid.Row="1" Grid.ColumnSpan="5" Header="配方说明（配平依据、缺失与复用素材）" Margin="0,4,0,0"
                              Foreground="{StaticResource TextSecondary}"
                              Visibility="{Binding HasRecipeNotes, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding RecipeNotes, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto" Background="#1B2128" FontSize="13"/>
                    </Expander>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Content="添加层" Command="{Binding AddLayerCommand}"/>
                    <TextBlock Text="启用需要的层，直接输入增益与延时；‘设置’中选择素材。" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                </DockPanel>
                <ListBox x:Name="LayerList" Grid.Row="2" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                         MaxHeight="280" AutomationProperties.Name="混音分层列表" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" Background="{StaticResource RowBg}" BorderBrush="{StaticResource BorderLight}"
                                    BorderThickness="1" CornerRadius="5" Padding="10" MouseLeftButtonDown="OnLayerRowMouseDown"
                                    ContextMenuOpening="OnLayerContextMenu">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <WrapPanel Margin="0,0,8,0">
                                    <CheckBox IsChecked="{Binding Enabled}" Width="112" VerticalAlignment="Center" Margin="0,0,12,6" AutomationProperties.Name="{Binding Name, StringFormat=启用层：{0}}">
                                        <TextBlock Text="{Binding Name}" MaxWidth="80" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </CheckBox>
                                    <ToggleButton Content="独听" IsChecked="{Binding Solo}" Style="{StaticResource ToggleButton}" Margin="0,0,12,6"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=独听层：{0}}" ToolTip="只影响监听，可独听多层；不改变导出内容"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                        <TextBlock Text="增益 dB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="80" Style="{StaticResource NumericBox}" Text="{Binding GainDb, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                                 AutomationProperties.Name="{Binding Name, StringFormat=层增益 dB：{0}}" ToolTip="-60 ～ +6 dB；离开输入框生效"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                        <TextBlock Text="延时 ms" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="80" Style="{StaticResource NumericBox}" Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}"
                                                 AutomationProperties.Name="{Binding Name, StringFormat=层延时 ms：{0}}" ToolTip="0 ～ 1000 ms"/>
                                    </StackPanel>
                                    <Button Content="试听" Click="OnPlayLayerClick" Margin="0,0,0,6"
                                            AutomationProperties.Name="{Binding Name, StringFormat=试听层：{0}}"/>
                                    </WrapPanel>
                                    <Button Grid.Column="1" Content="设置" VerticalAlignment="Top" Click="OnLayerSettingsClick" AutomationProperties.Name="{Binding Name, StringFormat=编辑层设置：{0}}"/>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,10,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding PoolDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PoolDisplay}"/>
                                            <TextBlock Text="{Binding CurrentVariant}" Foreground="{StaticResource AccentText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentVariant}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource InputBg}" CornerRadius="3" ClipToBounds="True">
                                            <ctl:WaveformView Peaks="{Binding Peaks}" Height="36"/>
                                        </Border>
                                    </Grid>

                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{StaticResource RowBgSelected}"/>
                                    <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter TargetName="row" Property="Background" Value="{StaticResource PanelBg}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 序列 -->
                <Border Grid.Row="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="3  序列试听" Style="{StaticResource SectionHeader}"/>
                        <WrapPanel>
                            <ToggleButton Content="单发" IsChecked="{Binding SingleMode}" Style="{StaticResource ToggleButton}" Margin="0,0,6,8"/>
                            <ToggleButton Content="连发" IsChecked="{Binding BurstMode}" Style="{StaticResource ToggleButton}" Margin="0,0,16,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <TextBlock Text="射速 RPM" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding BurstRpm, UpdateSourceTrigger=LostFocus}" Width="66" IsEnabled="{Binding BurstMode}" Style="{StaticResource NumericBox}" AutomationProperties.Name="连发射速 RPM"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                                <TextBlock Text="发数" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding BurstShotCount, UpdateSourceTrigger=LostFocus}" Width="54" IsEnabled="{Binding BurstMode}" Style="{StaticResource NumericBox}" AutomationProperties.Name="连发发数"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ManifestStatus}" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="{Binding ManifestStatusColor, Converter={StaticResource StringToBrush}}"/>
                        </WrapPanel>
                        <ctl:TimelineCanvas Markers="{Binding TimelineMarkers}" TotalSeconds="{Binding TotalSeconds}"
                                            PlayheadSeconds="{Binding PlayheadSeconds}" Height="88" Margin="0,8,0,0"/>
                        <Expander Header="变体、A/B 对比与事件表" Margin="0,6,0,0">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <TextBlock Text="固定种子" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Text="{Binding RandomSeed, UpdateSourceTrigger=LostFocus}" Width="88" Style="{StaticResource NumericBox}" Margin="0,0,8,8" AutomationProperties.Name="配方随机种子"/>
                                    <Button Content="重新生成变体" Command="{Binding RegenerateCommand}" Margin="0,0,16,8"/>
                                    <CheckBox Content="松扳机尾音（实验）" IsChecked="{Binding ReleaseTailEnabled}" IsEnabled="{Binding ReleaseTailAvailable}" Margin="0,0,0,8" VerticalAlignment="Center"/>
                                </WrapPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel>
                                <TextBlock Text="A/B：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                <Button Content="存为 A" Command="{Binding SetSnapshotACommand}"/>
                                <Button Content="存为 B" Command="{Binding SetSnapshotBCommand}" Margin="6,0,0,0"/>
                                <Button Content="应用 A" Command="{Binding ApplySnapshotACommand}" Margin="6,0,0,0"
                                        ToolTip="{Binding SnapshotALabel}"/>
                                <Button Content="应用 B" Command="{Binding ApplySnapshotBCommand}" Margin="6,0,0,0"
                                        ToolTip="{Binding SnapshotBLabel}"/>
                                <TextBlock Text="监听补偿 dB" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource TextSecondary}"/>
                                <TextBox Text="{Binding MonitorCompensationDb, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.0}}" Width="56"
                                         Style="{StaticResource NumericBox}"
                                         ToolTip="仅影响监听，显示数值；不进入导出"/>
                            </WrapPanel>
                        </Grid>
                        <Expander Header="事件表（展开可查看与替换每发样本）" Margin="0,8,0,0" Foreground="{StaticResource TextSecondary}">
                            <DataGrid ItemsSource="{Binding EventRows}" MaxHeight="170" FontSize="13"
                                      MouseRightButtonUp="OnEventRowRightClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="层" Binding="{Binding LayerName}" Width="90"/>
                                    <DataGridTextColumn Header="发" Binding="{Binding ShotDisplay}" Width="70"/>
                                    <DataGridTextColumn Header="起点 s" Binding="{Binding TimeS}" Width="80"/>
                                    <DataGridTextColumn Header="文件" Binding="{Binding File}" Width="*"/>
                                    <DataGridTextColumn Header="增益 dB" Binding="{Binding GainDb, StringFormat={}{0:0.0}}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                            </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </Border>
            </Grid>

            </ScrollViewer>
            <!-- ── 右：属性区 ── -->
            <Border x:Name="LayerInspector" Grid.Column="2" Visibility="Collapsed" Margin="8,0,0,0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Style="{StaticResource SectionHeader}" TextWrapping="Wrap">
                            <Run Text="层属性　"/>
                            <Run Text="{Binding SelectedLayer.Name, Mode=OneWay}" Foreground="{StaticResource AccentText}"/>
                        </TextBlock>

                        <TextBlock Text="素材格式" Style="{StaticResource HintText}"/>
                        <TextBlock Text="{Binding SelectedLayer.FormatDisplay}" Margin="0,0,0,8"/>

                        <TextBlock Text="文件长度" Style="{StaticResource HintText}"/>
                        <TextBlock Text="{Binding SelectedLayer.LengthDisplay}" Margin="0,0,0,8"/>

                        <TextBlock Text="完整路径（可复制）" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding SelectedLayer.PathDisplay, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="选中层文件路径，可复制"
                                 MaxHeight="60" VerticalScrollBarVisibility="Auto" Background="#1B2128" Margin="0,2,0,8"/>

                        <TextBlock Text="样本选择" Style="{StaticResource HintText}"/>
                        <ComboBox SelectedValue="{Binding SelectedLayer.VariantMode}" SelectedValuePath="Value" AutomationProperties.Name="选中层样本选择方式"
                                  DisplayMemberPath="Label" ItemsSource="{Binding VariantModeOptions}" Margin="0,2,0,4"/>
                        <TextBlock Text="随机种子（空白沿用配方）" Style="{StaticResource HintText}"/>
                        <TextBox Text="{Binding SelectedLayer.Seed, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{StaticResource NumericBox}" Margin="0,4,0,8" AutomationProperties.Name="选中层随机种子"/>
                        <TextBlock Text="固定样本" Style="{StaticResource HintText}"/>
                        <ComboBox ItemsSource="{Binding SelectedLayer.Pool}" SelectedValuePath="Id" DisplayMemberPath="VariantLabel" SelectedValue="{Binding SelectedLayer.FixedAssetId}" Margin="0,4,0,12" AutomationProperties.Name="固定样本文件"/>
                        <TextBlock Text="素材池（选定分组指定到该层）" Style="{StaticResource HintText}"/>
                        <ComboBox x:Name="CmbPoolAssign" ItemsSource="{Binding AvailableGroupKeys}" Margin="0,2,0,8" AutomationProperties.Name="选择素材池分组"
                                  ToolTip="把当前武器的某个分组作为该层素材池"/>
                        <Button Content="把选定分组指定到该层" Click="OnAssignPoolClick"/>

                        <TextBlock Text="增益 dB" Style="{StaticResource HintText}" Margin="0,14,0,0"/>
                        <Slider Minimum="-60" Maximum="6" Value="{Binding SelectedLayer.GainDb}" SmallChange="0.5" LargeChange="3" AutomationProperties.Name="选中层增益滑杆"/>
                        <TextBlock Text="延时 ms" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        <Slider Minimum="0" Maximum="1000" Value="{Binding SelectedLayer.DelayMs}" SmallChange="0.1" LargeChange="10" AutomationProperties.Name="选中层延时滑杆"/>
                        <Expander Header="响度与高级触发规则" Margin="0,14,0,0">
                            <StackPanel>
                        <TextBlock Text="素材响度（配平依据）" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedLayer.LoudnessDisplay}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="连发同时发声上限" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource HintText}"/>
                            <TextBox Text="{Binding SelectedLayer.BurstVoiceLimit, UpdateSourceTrigger=LostFocus}" Width="56" AutomationProperties.Name="连发同时发声上限"
                                     Style="{StaticResource NumericBox}"
                                     ToolTip="0 = 不限；超出时最旧实例在新一发起点 30 ms 淡出（只影响连发，单发不受影响）"/>
                        </StackPanel>
                        <TextBlock Text="全自动枪型的 ATMO 默认限 3–4 个实例，防止长连射空间层堆高；试混建议，非原版参数"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <Separator/>

                        <TextBlock Text="实验触发规则" Style="{StaticResource HintText}"/>
                        <CheckBox IsChecked="{Binding SelectedLayer.IsExperimental}"
                                  Margin="0,2,0,4">
                            <TextBlock Text="作为实验层启用（last / interrupt / FCG）" TextWrapping="Wrap"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ComboBox Width="130" SelectedValue="{Binding SelectedLayer.Trigger}" SelectedValuePath="Value" AutomationProperties.Name="实验层触发规则"
                                      DisplayMemberPath="Label" ItemsSource="{Binding TriggerOptions}"
                                      IsEnabled="{Binding SelectedLayer.IsExperimental}"/>
                            <TextBlock Text="第 N 发" Margin="8,0,6,0" VerticalAlignment="Center" Style="{StaticResource HintText}"/>
                            <TextBox Text="{Binding SelectedLayer.TriggerShotNumber, UpdateSourceTrigger=LostFocus}" Width="44" AutomationProperties.Name="实验层触发发数"
                                     IsEnabled="{Binding SelectedLayer.IsExperimental}"/>
                        </StackPanel>
                        <TextBlock Text="用户设定，原版条件未确认；释放时刻 = 最后一发起点 + 一个射击间隔" Style="{StaticResource WarnText}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="规则来源" Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedLayer.RuleSource}" Margin="0,0,0,8"/>

                            </StackPanel>
                        </Expander>
                        <WrapPanel Margin="0,18,0,0">
                            <Button Content="重命名层" Command="{Binding RenameLayerCommand}" Margin="0,0,8,8"/>
                            <Button Content="删除层" Command="{Binding RemoveLayerCommand}" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <Button Content="高级开火场景…" Click="OnOpenFireStudio" ToolTip="弹药、末弹、动作、声音定义与条件事件映射"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5" Margin="0,10,0,0" Padding="12,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" Foreground="{StaticResource TextSecondary}" Margin="12,0,16,0"/>
                        <TextBlock Text="L" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="LevelLBar" Width="56" Height="10" Maximum="1" Value="{Binding LevelL, Mode=OneWay}" Margin="6,0,12,0" AutomationProperties.Name="左声道电平"/>
                        <TextBlock Text="R" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="LevelRBar" Width="56" Height="10" Maximum="1" Value="{Binding LevelR, Mode=OneWay}" Margin="6,0,0,0" AutomationProperties.Name="右声道电平"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="播放预览" Command="{Binding PlayCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" ToolTip="空格播放；焦点在按钮或输入框时保留控件操作"/>
                        <Button Content="停止试听" Command="{Binding StopCommand}" Margin="0,0,16,0"/>
                        <Button Content="撤销" Command="{Binding UndoCommand}" Margin="0,0,6,0"/>
                        <Button Content="重做" Command="{Binding RedoCommand}" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding PlayTimeText}" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </WrapPanel>
                </DockPanel>
                <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="WorkspaceStatus" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
                <TextBox x:Name="WorkspaceError" Text="{Binding ErrorText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="88" VerticalScrollBarVisibility="Auto"
                         Foreground="{StaticResource ErrorRed}" Margin="0,8,0,0" AutomationProperties.Name="操作错误，可选择并复制" AutomationProperties.LiveSetting="Assertive">
                    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers><DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style></TextBox.Style>
                </TextBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
